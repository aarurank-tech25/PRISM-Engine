# ==========================================
# PRISM Engine — Environment Configuration Template
# ==========================================

# Backend (backend/.env)
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=prism_engine
# Path to optional Firebase service account JSON for production token verification
FIREBASE_SERVICE_ACCOUNT_PATH=

# Frontend (frontend/.env)
# Optional Firebase Web App configuration for production authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
